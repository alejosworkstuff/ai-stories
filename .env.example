# --- LLM provider (Vercel AI SDK, OpenAI-compatible) ---
# Default: Groq free tier (llama-3.x). Get a key at https://console.groq.com/keys
# Alternatives: OpenRouter (free-model routes), Google AI Studio (Gemini) — any
# OpenAI-compatible endpoint works; change AI_BASE_URL + AI_API_KEY + model ids.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# Optional alias — sync-vercel-env.mjs reads GROQ_API_KEY when AI_API_KEY is unset.
GROQ_API_KEY=
# Chat model id as exposed by your provider.
AI_MODEL=openai/gpt-oss-120b
# Embedding model (only used when FORCE_LOCAL_EMBEDDINGS is unset).
AI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimension (must match AI_EMBEDDING_MODEL). 1536 for
# text-embedding-3-small. When AI_BASE_URL is unset, ingest/retrieval use the
# offline bag-of-words embedder (384 dims).
EMBEDDING_DIM=1536
# Keep bag-of-words retrieval when the corpus was ingested offline (384 dims)
# but chat generation uses a remote OpenAI-compatible provider in production.
# Required for Groq (no embedding API) when the Neon corpus uses local vectors.
FORCE_LOCAL_EMBEDDINGS=1

# --- RAG / memory store (Postgres + pgvector on Neon) ---
# Pooled Neon connection string. The RAG corpus and optional conversation
# memory live here. pgvector ('vector' extension) is required (npm run db:setup).
DATABASE_URL=

# --- Observability (optional) ---
# When set, generation telemetry (prompt, tokens, latency, tool calls) is also
# forwarded to Langfuse. When unset, telemetry is logged as structured JSON only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
