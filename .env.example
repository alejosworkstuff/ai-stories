# --- LLM provider (Vercel AI SDK, OpenAI-compatible) ---
# The flagship talks to the LLM through the Vercel AI SDK's OpenAI-compatible
# provider. Point AI_BASE_URL at any OpenAI-compatible endpoint.
#
# To "keep Replicate": run a Replicate -> OpenAI-compatible gateway (e.g. an
# open-source replicate-openai gateway, or a hosted BYOK gateway) and reuse your
# existing Replicate token as AI_API_KEY. To swap to OpenAI/Anthropic/Groq later,
# just change AI_BASE_URL + AI_API_KEY + the model ids below.
AI_BASE_URL=https://your-openai-compatible-gateway/v1
AI_API_KEY=
# Existing Replicate token (used as AI_API_KEY default when AI_API_KEY is unset).
REPLICATE_API_TOKEN=
# Chat + embedding model ids as exposed by your gateway/provider.
AI_MODEL=meta/meta-llama-3-8b-instruct
AI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimension (must match AI_EMBEDDING_MODEL). 1536 for
# text-embedding-3-small on an OpenAI-compatible gateway. When AI_BASE_URL is
# unset, ingest/retrieval use the offline bag-of-words embedder (384 dims).
EMBEDDING_DIM=1536

# --- RAG / memory store (Postgres + pgvector on Neon) ---
# Pooled Neon connection string. The RAG corpus and optional conversation
# memory live here. pgvector ('vector' extension) is required (npm run db:setup).
DATABASE_URL=

# --- Observability (optional) ---
# When set, generation telemetry (prompt, tokens, latency, tool calls) is also
# forwarded to Langfuse. When unset, telemetry is logged as structured JSON only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
