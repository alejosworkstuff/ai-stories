{
  "name": "ai-stories",
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://ai-stories-ashy.vercel.app",
  "description": "AI story generator: streaming RAG + agentic generation on the Vercel AI SDK, grounded by pgvector on Neon, with typed outputs, guardrails, an eval harness, and observability.",
  "keywords": [
    "portfolio",
    "typescript",
    "nodejs",
    "tailwindcss",
    "ai",
    "vercel-ai-sdk",
    "rag",
    "pgvector",
    "agents",
    "llm",
    "streaming",
    "evals",
    "zod"
  ],
  "scripts": {
    "dev": "vercel dev",
    "build:client": "tsc --target ES2022 --module ES2022 --moduleResolution Bundler --outDir public/js --rootDir lib --declaration false --sourceMap false lib/stream-debugger/parser.ts lib/stream-debugger/control-chars.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:client && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs evals/run.ts",
    "eval:baseline": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs evals/record-baseline.ts",
    "eval:ci": "node scripts/eval-ci.mjs",
    "db:setup": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/db-setup.ts",
    "db:ingest": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/ingest-corpus.ts",
    "db:verify": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/verify-retrieval.ts",
    "check:env-example": "node scripts/validate-env-example.mjs",
    "build:css": "tailwindcss -i ./styles/main.css -o ./public/css/app.css --minify",
    "ci": "npm run build:css && npm run build:client && npm run typecheck && npm run test && npm run check:env-example",
    "ci:full": "npm run ci && npm run test:e2e"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.32",
    "@neondatabase/serverless": "^0.10.0",
    "ai": "^7.0.70",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "serve": "^14.2.4",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
