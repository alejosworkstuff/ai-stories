{
  "name": "ai-stories",
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://ai-stories-ashy.vercel.app",
  "description": "AI story generator: streaming RAG + agentic generation on the Vercel AI SDK, grounded by pgvector on Neon, with typed outputs, guardrails, an eval harness, and observability.",
  "keywords": [
    "portfolio",
    "typescript",
    "nodejs",
    "ai",
    "vercel-ai-sdk",
    "rag",
    "pgvector",
    "agents",
    "llm",
    "streaming",
    "evals",
    "zod"
  ],
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs evals/run.ts",
    "eval:baseline": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs evals/record-baseline.ts",
    "eval:ci": "node scripts/eval-ci.mjs",
    "db:setup": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/db-setup.ts",
    "db:ingest": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/ingest-corpus.ts",
    "db:verify": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/verify-retrieval.ts",
    "check:env-example": "node scripts/validate-env-example.mjs",
    "ci": "npm run typecheck && npm run test && npm run check:env-example",
    "ci:full": "npm run ci && npm run test:e2e"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@neondatabase/serverless": "^0.10.0",
    "ai": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "serve": "^14.2.4",
    "sharp": "^0.35.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
